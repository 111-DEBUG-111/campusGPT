# ─── Required ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Admin Security ────────────────────────────────────────────────────────────
# Change this to a strong random string in production
ADMIN_API_KEY=change-me-in-production

# ─── Frontend URL (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Qdrant Cloud ─────────────────────────────────────────────────────────────
# Get these from https://cloud.qdrant.io → Create cluster → API Keys
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=campusgpt_docs

# ─── Embedding Model ──────────────────────────────────────────────────────────
# bge-small-en-v1.5 = ~120MB (recommended for Render free tier)
# BAAI/bge-m3       = ~1GB   (requires self-hosted / paid tier)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── Database (SQLite for metadata/analytics) ─────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/campusgpt.db

# ─── Upload Settings ──────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ─── RAG Tuning ───────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
BM25_TOP_K=20
VECTOR_TOP_K=20
RERANKER_TOP_K=5
MAX_CONTEXT_CHUNKS=5
MAX_QUERY_REWRITES=3

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20

# ─── Debug ────────────────────────────────────────────────────────────────────
DEBUG=false

HISTORY_WINDOW=10                  # recent messages sent to LLM
SUMMARIZE_THRESHOLD=50             # message count before auto-summarization
CACHE_TTL_SECONDS=86400            # response cache lifetime (24h)
CACHE_SIMILARITY_THRESHOLD=0.97    # cosine sim for cache hit
CACHE_MAX_MEMORY_ENTRIES=500       # in-memory LRU size
MEMORY_RETRIEVAL_TOP_K=3           # memories injected per query

