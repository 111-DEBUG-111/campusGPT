GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── Fallback LLM Providers ───────────────────────────────────────────────────
# Get Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# ─── Admin Security ────────────────────────────────────────────────────────────
# Change this to a strong random string in production
ADMIN_API_KEY=change-me-in-production

# ─── User Authentication (Anonymous Sessions) ──────────────────────────────────
# CampusGPT uses anonymous session tokens — no user accounts required.
# The frontend generates a UUID v4 on first visit, stores it in localStorage,
# and sends it as the X-Session-Token header on every API request.
# The backend scopes all conversation data to that token.
# No configuration is needed here — this is handled automatically by the app.

# ─── Frontend URL (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Qdrant Cloud ─────────────────────────────────────────────────────────────
# Get these from https://cloud.qdrant.io → Create cluster → API Keys
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=campusgpt_docs

# ─── Embedding Model ──────────────────────────────────────────────────────────
# bge-small-en-v1.5 = ~120MB (recommended for Render free tier)
# BAAI/bge-m3       = ~1GB   (requires self-hosted / paid tier)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Sign up at https://neon.tech → create project → copy connection string
# IMPORTANT: change the scheme from postgresql:// to postgresql+asyncpg://
# IMPORTANT: remove ALL query params (?sslmode=require&channel_binding=require etc.)
#            SSL is handled via connect_args in database.py — no URL params needed.
DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password@ep-xxxx.us-east-2.aws.neon.tech/neondb

# ─── Supabase Storage (S3-compatible, free 1GB — no credit card needed) ────────
# 1. Sign up at https://supabase.com → create a new project
# 2. Go to Storage → Create bucket (name: campusgpt-uploads, set to Private)
# 3. Go to Storage → S3 Connection → copy the credentials below
STORAGE_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY_ID=your_supabase_s3_access_key
STORAGE_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
STORAGE_BUCKET_NAME=campusgpt-uploads
# Optional: public URL if bucket is set to public
# STORAGE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public/campusgpt-uploads

# ─── Upload Settings ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ─── RAG Tuning ───────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
BM25_TOP_K=20
VECTOR_TOP_K=20
RERANKER_TOP_K=5
MAX_CONTEXT_CHUNKS=5
MAX_QUERY_REWRITES=3

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests allowed per minute per real client IP.
# The limiter reads the true client IP from the X-Forwarded-For header
# (set by Render / any reverse-proxy) so NAT users and VPN hoppers are
# correctly scoped.
RATE_LIMIT_PER_MINUTE=20

# Rate-limit counters are stored in Upstash Redis so they survive restarts
# and are shared across Render workers.  Reuse the same Upstash database as
# the response cache — no extra cost on the free tier.
# Leave blank to fall back to in-memory storage (local dev).
# UPSTASH_REDIS_URL and UPSTASH_REDIS_TOKEN are already set in the Response
# Cache section above; no separate env vars needed.

# ─── Cold Start Optimization ──────────────────────────────────────────────────
# On Render free tier, the container is wiped every ~15min of inactivity.
# These two settings dramatically reduce the cold start penalty when pointed
# at a Render Persistent Disk (e.g. mounted at /data, $0.25/GB/month).
#
# BM25_CACHE_DIR: Where to persist the serialized BM25 index.
#   - Without persistent disk: /tmp (default) — survives worker restarts,
#     wiped on cold starts, but still saves the pgvector rebuild on hot restarts.
#   - With persistent disk:    /data/bm25_cache — survives cold starts entirely.
# BM25_CACHE_DIR=/data/bm25_cache
#
# HF_HOME: Where HuggingFace model weights are cached.
#   - Without persistent disk: /tmp/hf_cache (default) — models re-downloaded on cold start.
#   - With persistent disk:    /data/hf_cache — models downloaded once, reused forever.
# HF_HOME=/data/hf_cache

# ─── Debug ────────────────────────────────────────────────────────────────────
DEBUG=false
